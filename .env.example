# =====================================================================
# AI Anime Voice Studio - Environment Variables Configuration
# =====================================================================

# Optional: Groq API Key for intelligent story analysis and speaker detection
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: ElevenLabs API Key for primary ultra-expressive TTS synthesis
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: Default TTS engine preference ('elevenlabs' or 'edge-tts')
# Fallback to edge-tts will automatically happen if ElevenLabs is unavailable.
DEFAULT_TTS_ENGINE=elevenlabs
